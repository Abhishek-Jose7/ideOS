# Optional AI provider for summaries and decision help: groq, openai, anthropic, openrouter, or none.
IDEOS_AI_PROVIDER=none
# Keep this private. Leave unset for deterministic offline fallbacks.
# IDEOS_AI_API_KEY=your_provider_api_key_here
# Optional model override. Defaults depend on provider.
# IDEOS_AI_MODEL=

# Local is the default.
IDEOS_BACKEND=local

# For cloud mode, uncomment and set this after deploying the Worker.
# IDEOS_BACKEND=cloud
# IDEOS_WORKSPACE_URL=https://your-ideos-worker.your-subdomain.workers.dev
# IDEOS_API_KEY=replace-with-the-same-32-plus-character-secret-set-on-the-Worker
# Set IDEOS_AI_PROVIDER and IDEOS_AI_API_KEY as Worker secrets too; project .env values are not sent to the Worker.
